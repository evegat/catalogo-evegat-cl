---
import Layout from '../layouts/Layout.astro';
import toolsData from '../data/tools.json';

export function getStaticPaths() {
  return [
    {
      params: { category: 'govtech' },
      props: {
        categoryName: 'GovTech & Software Público',
        title: 'GovTech Chile · Herramientas Públicas y Modernización del Estado · Eduardo Vega',
        description: 'Soluciones operativas de software público, autodiagnóstico Ley 21.719, catastro nacional de ordenanzas e interoperabilidad de sistemas del Estado.',
        keywords: 'GovTech Chile, modernización del Estado, Ley 21.719, ordenanzas municipales, interoperabilidad PISEE, compras públicas, Eduardo Vega Toledo'
      }
    },
    {
      params: { category: 'civiltech' },
      props: {
        categoryName: 'CivilTech & Tecnología Ciudadana',
        title: 'CivilTech Chile · Tecnología Ciudadana y Control Social · Eduardo Vega',
        description: 'Herramientas de control social, alertas de compras públicas, estatuto administrativo de funcionarios, accesibilidad universal y triaje cívico.',
        keywords: 'CivilTech Chile, control social, Mercado Público, estatuto administrativo, funcionarios públicos, accesibilidad WCAG AAA, triaje cívico'
      }
    },
    {
      params: { category: 'docencia' },
      props: {
        categoryName: 'Docencia e IA Universitaria',
        title: 'Docencia e IA Pública · Herramientas Pedagógicas FAGOB · Eduardo Vega',
        description: 'Autodiagnóstico 5D de madurez docente con IA, auditor heurístico de pautas de examen, modelos predictivos escolares y asistentes socráticos.',
        keywords: 'Docencia con IA, Universidad de Chile, FAGOB, evaluación auténtica, EduVocación, asistente socrático, modelos predictivos Mineduc'
      }
    },
    {
      params: { category: 'datos' },
      props: {
        categoryName: 'Datos Abiertos & Finanzas Públicas',
        title: 'Datos Abiertos y Finanzas Municipales · Chile · Eduardo Vega',
        description: 'Catastros territoriales, observatorios de finanzas locales, Fondo Común Municipal (FCM), FIGEM y compras públicas de cambio climático.',
        keywords: 'Datos abiertos Chile, finanzas municipales, Fondo Común Municipal, FIGEM, compras cambio climático, gestión territorial'
      }
    }
  ];
}

const { category } = Astro.params;
const { categoryName, title, description, keywords } = Astro.props;

const filteredTools = toolsData.filter(t => t.category === category);
const categoryCount = filteredTools.length;
const totalTools = toolsData.length;

const totalRoadmapItems = filteredTools.reduce((acc, t) => {
  const s = t.roadmap.shipped?.length || 0;
  const n = t.roadmap.now?.length || 0;
  const x = t.roadmap.next?.length || 0;
  const l = t.roadmap.later?.length || 0;
  return acc + s + n + x + l;
}, 0);
---

<Layout title={title} description={description} keywords={keywords}>
  <!-- Schema.org SEO Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": title,
    "description": description,
    "url": `https://catalogo.evegat.cl/${category}`,
    "creator": {
      "@type": "Person",
      "name": "Eduardo Vega Toledo",
      "url": "https://evegat.cl"
    },
    "hasPart": filteredTools.map(t => ({
      "@type": "SoftwareApplication",
      "name": t.name,
      "operatingSystem": "Web",
      "applicationCategory": "GovernmentApplication",
      "description": t.desc,
      "url": t.url || `https://catalogo.evegat.cl/?p=${t.code}`
    }))
  })} />

  <!-- Barra de Navegación Institucional evegat.cl -->
  <header class="top-nav-shell">
    <div class="top-nav-inner">
      <a href="https://evegat.cl" class="brand-block">
        <span class="brand-mark">EVT</span>
        <div class="brand-text">
          <strong>Eduardo Vega Toledo</strong>
          <small>Gestión pública · evidencia · tecnología</small>
        </div>
      </a>
      <nav class="nav-links" aria-label="Navegación del sitio">
        <a href="https://catalogo.evegat.cl">← Catálogo General</a>
        <a href="https://evegat.cl/servicios/">Servicios</a>
        <a href="https://evegat.cl/contacto/">Contacto</a>
        <a href="https://evegat.cl" class="btn-back-portafolio">Portafolio Principal</a>
      </nav>
    </div>
  </header>

  <!-- Hero de Categoría SEO -->
  <section class="hero-shell">
    <div class="hero-inner">
      <nav class="category-breadcrumbs" aria-label="Miga de pan">
        <a href="https://catalogo.evegat.cl">Catálogo</a>
        <span class="bread-sep">/</span>
        <span class="bread-current">{categoryName}</span>
      </nav>
      <h1>{categoryName}</h1>
      <p class="hero-lead">{description}</p>

      <div class="trust-bar">
        <div class="trust-item">
          <span class="live-dot" aria-hidden="true"></span>
          <strong>{categoryCount}</strong> herramientas operativas
        </div>
        <span class="trust-sep">·</span>
        <div class="trust-item">
          <strong>{totalRoadmapItems}</strong> hitos de hoja de ruta
        </div>
        <span class="trust-sep">·</span>
        <div class="trust-item">
          <strong>100%</strong> código auditable y verificado
        </div>
      </div>
    </div>
  </section>

  <!-- Contenedor Principal de la Categoría -->
  <div class="app-shell">
    <div class="category-switch-bar">
      <span class="cs-label">Otras colecciones:</span>
      <div class="cs-links">
        <a href="/govtech" class:list={[{ active: category === 'govtech' }]}>GovTech</a>
        <a href="/civiltech" class:list={[{ active: category === 'civiltech' }]}>CivilTech</a>
        <a href="/docencia" class:list={[{ active: category === 'docencia' }]}>Docencia e IA</a>
        <a href="/datos" class:list={[{ active: category === 'datos' }]}>Datos & Finanzas</a>
        <a href="/" class="cs-all">Ver todo el catálogo (15) →</a>
      </div>
    </div>

    <!-- Grid de Herramientas de la Categoría -->
    <main class="catalog-view">
      <div class="tools-grid">
        {filteredTools.map(t => {
          const shippedCount = t.roadmap.shipped?.length || 0;
          const nowCount = t.roadmap.now?.length || 0;
          const nextCount = t.roadmap.next?.length || 0;
          const laterCount = t.roadmap.later?.length || 0;
          const totalItems = shippedCount + nowCount + nextCount + laterCount;

          return (
            <article class="tool-card" onclick={`openDrawerByCode('${t.code}')`}>
              <div>
                <div class="card-top">
                  <div class="card-badges">
                    <span class="card-code">{t.code}</span>
                    <span class={`card-category cat-${t.category}`}>{t.category}</span>
                  </div>
                  <span class="card-status">
                    <span class="live-dot" style="width: 6px; height: 6px;"></span>
                    {t.statusText}
                  </span>
                </div>
                <h3><a href="javascript:void(0)" onclick={`openDrawerByCode('${t.code}'); event.stopPropagation();`}>{t.name}</a></h3>
                <p class="card-desc">{t.desc}</p>
              </div>

              <div>
                <div class="card-roadmap-summary">
                  <span class="summary-text">
                    <strong>{shippedCount}</strong> entregados · <strong>{nowCount}</strong> en curso
                  </span>
                  <span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--archive-muted);">
                    {totalItems} hitos
                  </span>
                </div>

                <div class="card-actions" onclick="event.stopPropagation();">
                  <button class="btn-card-explore" onclick={`openDrawerByCode('${t.code}')`}>
                    Explorar Ficha & Roadmap →
                  </button>
                  {t.url && (
                    <a href={t.url} target="_blank" rel="noreferrer" class="btn-card-live" title="Abrir herramienta desplegada en producción">
                      Probar ↗
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </main>

    <!-- Sección de Enlace al Portafolio Completo -->
    <section class="cat-cta-section">
      <div class="cat-cta-card">
        <h3>¿Quieres explorar la hoja de ruta general?</h3>
        <p>Revisa el tablero Kanban unificado con los 42 hitos de todo el ecosistema MyWorld.</p>
        <a href="/?view=roadmap" class="btn-cat-roadmap">Ver Roadmap Completo →</a>
      </div>
    </section>
  </div>

  <!-- SLIDE-OVER DRAWER -->
  <div class="drawer-backdrop" id="drawerBackdrop" onclick="closeDrawer()"></div>
  <aside class="slide-drawer" id="slideDrawer" aria-hidden="true">
    <div class="drawer-header">
      <div class="drawer-header-top">
        <div class="drawer-meta-badges">
          <span class="drawer-code font-mono" id="drawerCode">P087</span>
          <span class="drawer-category-badge" id="drawerCategory">GovTech</span>
          <span class="drawer-status-badge" id="drawerStatus">● En producción</span>
        </div>
        <button class="drawer-close-btn" onclick="closeDrawer()" aria-label="Cerrar panel">&times;</button>
      </div>
      <h2 class="drawer-title" id="drawerTitle">Nombre de la Herramienta</h2>
      <p class="drawer-desc" id="drawerDesc">Descripción de la herramienta...</p>
      
      <div class="drawer-cta-bar">
        <a href="#" target="_blank" rel="noreferrer" class="drawer-btn-primary" id="drawerLiveBtn">
          Probar Herramienta en Vivo ↗
        </a>
      </div>
    </div>

    <div class="drawer-body">
      <div class="drawer-section">
        <h3 class="drawer-section-title">El Problema Público / Origen</h3>
        <p class="drawer-origin-text" id="drawerOrigin">Detalles del origen...</p>
      </div>

      <div class="drawer-section">
        <div class="drawer-section-head">
          <h3 class="drawer-section-title">Hoja de Ruta del Proyecto</h3>
          <span class="drawer-roadmap-count font-mono" id="drawerRoadmapCount">4 hitos</span>
        </div>
        <div class="drawer-roadmap-tabs">
          <button class="dr-tab active" data-drtab="shipped" onclick="switchDrawerRoadmapTab('shipped')">Entregado</button>
          <button class="dr-tab" data-drtab="now" onclick="switchDrawerRoadmapTab('now')">En Curso</button>
          <button class="dr-tab" data-drtab="next" onclick="switchDrawerRoadmapTab('next')">Próximo</button>
          <button class="dr-tab" data-drtab="later" onclick="switchDrawerRoadmapTab('later')">En Estudio</button>
        </div>
        <div class="drawer-roadmap-list" id="drawerRoadmapList"></div>
      </div>

      <div class="drawer-section drawer-b2g-box">
        <h4 class="b2g-box-title">Consultoría & Acompañamiento Técnico</h4>
        <p class="b2g-box-text">Adecuación normativa, diagnóstico de brechas y desarrollo a la medida para órganos del Estado.</p>
        <a href="https://evegat.cl/contacto/" target="_blank" class="b2g-box-link">Contactar a Eduardo Vega →</a>
      </div>
    </div>
  </aside>

  <!-- FOOTER INSTITUCIONAL -->
  <footer class="site-footer">
    <div class="footer-shell">
      <div class="footer-grid">
        <div class="footer-brand">
          <strong>Eduardo Vega Toledo</strong>
          <p>Políticas públicas, datos territoriales y tecnología con responsabilidad institucional.</p>
          <p class="footer-social">
            <a href="mailto:eduardo@evegat.cl">eduardo@evegat.cl</a> · 
            <a href="https://www.linkedin.com/in/evegat1989/" target="_blank" rel="noreferrer">LinkedIn</a>
          </p>
        </div>
        <nav class="footer-nav">
          <a href="https://catalogo.evegat.cl">Catálogo Principal</a>
          <a href="https://evegat.cl">Portafolio evegat.cl</a>
          <a href="https://evegat.cl/servicios/">Servicios</a>
        </nav>
        <div class="footer-meta">
          <p>© {new Date().getFullYear()} Eduardo Vega Toledo</p>
          <p>Santiago, Chile</p>
        </div>
      </div>
    </div>
  </footer>

  <!-- ESTILOS CANÓNICOS -->
  <style>
    .top-nav-shell {
      background: var(--archive-navy);
      border-bottom: 1px solid #245486;
      color: #edf4fb;
      padding: 0.75rem 1.5rem;
    }
    .top-nav-inner {
      max-width: 1280px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .brand-block {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #edf4fb;
    }
    .brand-mark {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      color: var(--archive-mint-accent);
      border: 2px solid #edf4fb;
      font-weight: 850;
      font-size: 0.92rem;
      letter-spacing: 0.04em;
      font-family: var(--font-mono);
      background: var(--archive-navy-deep);
    }
    .brand-text strong {
      display: block;
      color: #fff;
      font-size: 0.95rem;
      line-height: 1.2;
    }
    .brand-text small {
      color: var(--archive-mint-accent);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }
    .nav-links a {
      color: #c7d7e8;
      text-decoration: none;
      font-size: 0.82rem;
      font-weight: 600;
    }
    .btn-back-portafolio {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.25);
      padding: 0.35rem 0.75rem;
      border-radius: var(--radius-sm);
      color: #ffffff !important;
    }

    .hero-shell {
      background: var(--archive-paper);
      padding: 3rem 1.5rem 2rem 1.5rem;
      border-bottom: 1px solid var(--archive-line);
    }
    .hero-inner {
      max-width: 1280px;
      margin: 0 auto;
    }
    .category-breadcrumbs {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--archive-muted);
      margin-bottom: 0.75rem;
    }
    .category-breadcrumbs a {
      color: var(--archive-blue);
      text-decoration: none;
    }
    .bread-sep {
      margin: 0 6px;
      color: var(--archive-line-strong);
    }
    .bread-current {
      color: var(--archive-navy);
      font-weight: 700;
    }
    h1 {
      font-size: clamp(2.3rem, 3.8vw, 3.4rem);
      line-height: 1.05;
      color: var(--archive-ink);
      max-width: 980px;
      margin-bottom: 1rem;
    }
    .hero-lead {
      max-width: 860px;
      font-size: 1.05rem;
      line-height: 1.6;
      color: var(--archive-muted);
      margin-bottom: 1.75rem;
    }
    .trust-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid rgba(29, 77, 145, 0.18);
      font-size: 0.85rem;
      color: var(--archive-muted);
    }
    .trust-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .trust-item strong {
      color: var(--archive-ink);
      font-weight: 750;
    }
    .trust-sep {
      color: rgba(29, 77, 145, 0.35);
    }
    .live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--archive-mint);
      display: inline-block;
      box-shadow: 0 0 0 2px rgba(84, 185, 149, 0.25);
    }

    .app-shell {
      max-width: 1280px;
      margin: 0 auto;
      padding: 1.75rem 1.5rem 4rem 1.5rem;
      flex: 1;
      width: 100%;
    }
    .category-switch-bar {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--archive-line);
    }
    .cs-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--archive-navy);
      font-family: var(--font-mono);
      text-transform: uppercase;
    }
    .cs-links {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      align-items: center;
    }
    .cs-links a {
      background: #ffffff;
      border: 1px solid var(--archive-line);
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
      font-size: 0.82rem;
      color: var(--archive-muted);
      text-decoration: none;
      font-weight: 600;
    }
    .cs-links a.active {
      background: var(--archive-navy);
      color: #fff;
      border-color: var(--archive-navy);
    }
    .cs-all {
      color: var(--archive-blue) !important;
      border-color: rgba(11, 74, 162, 0.3) !important;
    }

    .tools-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: 1.5rem;
    }
    .tool-card {
      background: var(--archive-surface);
      border: 1px solid var(--archive-line);
      border-radius: var(--radius-md);
      padding: 1.4rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 1px 2px rgba(16, 21, 28, 0.04);
      cursor: pointer;
    }
    .tool-card:hover {
      border-color: var(--archive-line-strong);
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(6, 35, 74, 0.08);
    }
    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }
    .card-badges {
      display: flex;
      gap: 6px;
      align-items: center;
    }
    .card-code {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 750;
      color: var(--archive-navy);
      background: #eef4fb;
      padding: 2px 6px;
      border-radius: 3px;
      border: 1px solid rgba(11, 74, 162, 0.2);
    }
    .card-category {
      font-size: 0.7rem;
      font-weight: 650;
      padding: 2px 7px;
      border-radius: 3px;
      text-transform: uppercase;
    }
    .cat-govtech { background: #e0f2fe; color: #0369a1; }
    .cat-civiltech { background: #dcfce7; color: #15803d; }
    .cat-docencia { background: #fef3c7; color: #b45309; }
    .cat-datos { background: #f1f5f9; color: #475569; }

    .card-status {
      font-size: 0.72rem;
      font-weight: 650;
      display: flex;
      align-items: center;
      gap: 5px;
      color: var(--archive-mint);
    }
    .tool-card h3 {
      font-size: 1.25rem;
      line-height: 1.25;
      margin-bottom: 0.6rem;
    }
    .tool-card h3 a {
      color: var(--archive-ink);
      text-decoration: none;
    }
    .card-desc {
      color: var(--archive-muted);
      font-size: 0.85rem;
      line-height: 1.5;
      margin-bottom: 1.25rem;
    }
    .card-roadmap-summary {
      background: #faf8f5;
      border: 1px solid #ebd9c8;
      border-radius: var(--radius-sm);
      padding: 0.6rem 0.8rem;
      margin-bottom: 1.15rem;
      font-size: 0.75rem;
      color: var(--archive-muted);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .card-actions {
      display: flex;
      gap: 0.6rem;
      align-items: center;
      padding-top: 0.85rem;
      border-top: 1px solid rgba(29, 77, 145, 0.12);
    }
    .btn-card-explore {
      flex: 1;
      background: #f1f5f9;
      color: var(--archive-navy);
      border: 1px solid #cbd5e1;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.55rem 0.8rem;
      border-radius: var(--radius-sm);
      cursor: pointer;
    }
    .btn-card-explore:hover {
      background: var(--archive-navy);
      color: #fff;
    }
    .btn-card-live {
      background: var(--archive-blue);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.55rem 0.9rem;
      border-radius: var(--radius-sm);
      text-decoration: none;
    }

    .cat-cta-section {
      margin-top: 3.5rem;
      border-top: 1px solid var(--archive-line);
      padding-top: 2.5rem;
    }
    .cat-cta-card {
      background: var(--archive-surface);
      border: 1px solid var(--archive-line);
      border-radius: var(--radius-md);
      padding: 2rem;
      text-align: center;
    }
    .cat-cta-card h3 {
      font-size: 1.45rem;
      margin-bottom: 0.5rem;
    }
    .cat-cta-card p {
      color: var(--archive-muted);
      font-size: 0.92rem;
      margin-bottom: 1.25rem;
    }
    .btn-cat-roadmap {
      background: var(--archive-navy);
      color: #fff;
      text-decoration: none;
      padding: 0.65rem 1.4rem;
      font-size: 0.88rem;
      font-weight: 700;
      border-radius: var(--radius-sm);
      display: inline-block;
    }

    /* DRAWER & FOOTER (Reutilizados) */
    .drawer-backdrop {
      position: fixed; inset: 0; background: rgba(4, 26, 55, 0.4);
      backdrop-filter: blur(2px); z-index: 998; opacity: 0; pointer-events: none; transition: opacity 0.25s ease;
    }
    .drawer-backdrop.active { opacity: 1; pointer-events: auto; }
    .slide-drawer {
      position: fixed; top: 0; right: 0; bottom: 0; width: min(580px, 94vw);
      background: #ffffff; z-index: 999; box-shadow: -10px 0 35px rgba(6, 35, 74, 0.16);
      display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .slide-drawer.active { transform: translateX(0); }
    .drawer-header { background: var(--archive-paper); padding: 1.5rem; border-bottom: 1px solid var(--archive-line); }
    .drawer-header-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
    .drawer-meta-badges { display: flex; gap: 8px; align-items: center; }
    .drawer-code { background: var(--archive-navy); color: #fff; font-size: 0.78rem; font-weight: 750; padding: 3px 8px; border-radius: 4px; }
    .drawer-category-badge { font-size: 0.75rem; font-weight: 650; color: var(--archive-navy); background: #eef4fb; padding: 2px 8px; border-radius: 4px; }
    .drawer-status-badge { font-size: 0.75rem; font-weight: 650; color: var(--archive-mint); }
    .drawer-close-btn { background: none; border: 1px solid var(--archive-line); width: 32px; height: 32px; border-radius: 50%; font-size: 1.25rem; color: var(--archive-muted); cursor: pointer; }
    .drawer-title { font-size: 1.65rem; margin-bottom: 0.5rem; line-height: 1.2; }
    .drawer-desc { color: var(--archive-muted); font-size: 0.9rem; line-height: 1.5; margin-bottom: 1.2rem; }
    .drawer-cta-bar { display: flex; gap: 0.75rem; }
    .drawer-btn-primary { background: var(--archive-blue); color: #fff; text-decoration: none; padding: 0.6rem 1.2rem; font-size: 0.85rem; font-weight: 700; border-radius: var(--radius-sm); }
    .drawer-body { flex: 1; overflow-y: auto; padding: 1.5rem; display: flex; flex-direction: column; gap: 1.75rem; }
    .drawer-section-title { font-size: 1.15rem; margin-bottom: 0.6rem; color: var(--archive-navy); }
    .drawer-origin-text { font-size: 0.88rem; line-height: 1.6; color: var(--archive-muted); background: #fbf9f4; padding: 0.85rem 1rem; border-left: 3px solid var(--archive-blue); }
    .drawer-section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
    .drawer-roadmap-count { font-size: 0.78rem; color: var(--archive-muted); }
    .drawer-roadmap-tabs { display: flex; gap: 4px; background: #f1f5f9; padding: 3px; border-radius: var(--radius-sm); margin-bottom: 1rem; }
    .dr-tab { flex: 1; background: transparent; border: none; padding: 0.35rem; font-size: 0.75rem; font-weight: 650; color: var(--archive-muted); cursor: pointer; border-radius: 3px; }
    .dr-tab.active { background: #ffffff; color: var(--archive-navy); }
    .drawer-roadmap-list { display: flex; flex-direction: column; gap: 0.75rem; }
    .drawer-item-card { border: 1px solid var(--archive-line); border-radius: var(--radius-sm); padding: 0.85rem; background: #ffffff; }
    .drawer-item-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem; }
    .drawer-item-title { font-weight: 700; font-size: 0.88rem; color: var(--archive-ink); }
    .drawer-item-desc { font-size: 0.8rem; color: var(--archive-muted); line-height: 1.45; }
    .drawer-b2g-box { background: #edf4fb; border: 1px solid #bfdbfe; border-radius: var(--radius-md); padding: 1.25rem; }
    .b2g-box-title { font-size: 0.98rem; color: var(--archive-navy); margin-bottom: 0.35rem; font-weight: 750; font-family: var(--font-sans); }
    .b2g-box-text { font-size: 0.84rem; color: var(--archive-muted); line-height: 1.5; margin-bottom: 0.75rem; }
    .b2g-box-link { font-size: 0.84rem; font-weight: 750; color: var(--archive-blue); text-decoration: none; }

    .site-footer { background: var(--archive-navy-deep); color: #edf4fb; padding: 3rem 1.5rem 2.5rem 1.5rem; margin-top: auto; border-top: 1px solid #245486; }
    .footer-shell { max-width: 1280px; margin: 0 auto; }
    .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 2.5rem; }
    .footer-brand strong { font-size: 1.1rem; display: block; margin-bottom: 0.5rem; color: #ffffff; }
    .footer-brand p { font-size: 0.82rem; color: #a5b5c9; }
    .footer-social { margin-top: 0.85rem; font-size: 0.82rem; }
    .footer-social a { color: #cbd7e5; text-decoration: none; }
    .footer-nav { display: flex; flex-direction: column; gap: 0.6rem; }
    .footer-nav a { color: #cbd7e5; text-decoration: none; font-size: 0.82rem; }
    .footer-meta { font-size: 0.78rem; color: #7e9fc5; text-align: right; }
  </style>

  <script is:inline define:vars={{ toolsData }}>
    let activeDrawerIndex = -1;
    let activeDrawerTab = 'shipped';

    function openDrawerByCode(code) {
      const idx = toolsData.findIndex(t => t.code === code);
      if (idx !== -1) {
        activeDrawerIndex = idx;
        const tool = toolsData[idx];
        document.getElementById('drawerCode').textContent = tool.code;
        document.getElementById('drawerCategory').textContent = tool.category.toUpperCase();
        document.getElementById('drawerStatus').textContent = `● ${tool.statusText}`;
        document.getElementById('drawerTitle').textContent = tool.name;
        document.getElementById('drawerDesc').textContent = tool.desc;
        document.getElementById('drawerOrigin').textContent = tool.origin;

        const liveBtn = document.getElementById('drawerLiveBtn');
        if (tool.url) {
          liveBtn.href = tool.url;
          liveBtn.style.display = 'inline-flex';
        } else {
          liveBtn.style.display = 'none';
        }

        const totalHitos = (tool.roadmap.shipped?.length || 0) + (tool.roadmap.now?.length || 0) + (tool.roadmap.next?.length || 0) + (tool.roadmap.later?.length || 0);
        document.getElementById('drawerRoadmapCount').textContent = `${totalHitos} hitos documentados`;

        renderDrawerRoadmapTab(tool, activeDrawerTab);

        document.getElementById('drawerBackdrop').classList.add('active');
        document.getElementById('slideDrawer').classList.add('active');
        document.getElementById('slideDrawer').setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeDrawer() {
      document.getElementById('drawerBackdrop').classList.remove('active');
      document.getElementById('slideDrawer').classList.remove('active');
      document.getElementById('slideDrawer').setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      activeDrawerIndex = -1;
    }

    function switchDrawerRoadmapTab(tab) {
      activeDrawerTab = tab;
      document.querySelectorAll('.dr-tab').forEach(b => {
        b.classList.toggle('active', b.dataset.drtab === tab);
      });
      if (activeDrawerIndex !== -1) {
        renderDrawerRoadmapTab(toolsData[activeDrawerIndex], tab);
      }
    }

    function renderDrawerRoadmapTab(tool, tab) {
      const items = tool.roadmap[tab] || [];
      const list = document.getElementById('drawerRoadmapList');
      if (!items.length) {
        list.innerHTML = `<p style="font-size: 0.8rem; color: #94a3b8; font-style: italic; padding: 0.75rem 0;">No hay hitos registrados en este estado.</p>`;
        return;
      }
      list.innerHTML = items.map(i => `
        <div class="drawer-item-card">
          <div class="drawer-item-top">
            <span class="drawer-item-title">${i.title}</span>
            <span style="font-size: 0.65rem; background: #f1f5f9; padding: 1px 5px; border-radius: 3px; font-weight: 650; color: #475569;">${i.tag || 'General'}</span>
          </div>
          <p class="drawer-item-desc">${i.desc}</p>
        </div>
      `).join('');
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDrawer();
    });
  </script>
</Layout>
